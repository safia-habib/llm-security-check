# LLM Security Check — environment variables
# Copy this file to .env and set values for local development.
# Never commit .env to version control.

# Listen port
PORT=8000

# Crawl limits
MAX_PAGES=20
MAX_ASSETS=30

# Timeouts (seconds)
SCAN_TIMEOUT_SECONDS=120
REQUEST_TIMEOUT_SECONDS=10

# How long a scan report stays in memory before expiry
SCAN_TTL_MINUTES=30

# Rate limiting: scans allowed per client IP per hour
RATE_LIMIT_PER_HOUR=5

# DANGER: Set to true only for local development against localhost fixtures.
# The app logs a loud warning on every startup and every scan when this is true.
# Must be false in any public or shared deployment.
ALLOW_PRIVATE_TARGETS=false

# User-Agent header sent with every scanner request
USER_AGENT=LLMSecurityCheck/1.0 (+https://github.com/placeholder/llm-security-check)
